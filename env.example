# DJANGO
DJANGO_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# DERIV
DERIV_APP_ID=1089
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_MODO_REAL=False
DERIV_CONFIRMAR_REAL=NO
DERIV_DURACION_TICKS=5
DERIV_MAX_DURACION_TICKS=10
DERIV_MIN_STAKE=1.0
# (Opcional) Stake fijo por operación (USD). Ej: 0.5 para operar con $0.50.
# Si no se configura DERIV_STAKE_FIJO, el bot calculará el stake como:
# - 1% del balance actual (crece proporcionalmente con el capital)
# - Mínimo: 0.35 USD (si el 1% es menor, usar 0.35)
# Nota: el bot respetará límites de riesgo/capital y DERIV_MIN_STAKE.
DERIV_STAKE_FIJO=
DERIV_HISTORIAL_LIMIT=50
DERIV_HISTORIAL_CADA_SEGUNDOS=10
# Cada cuántos segundos guardar un punto de balance para la gráfica.
BALANCE_SNAPSHOT_CADA_SEG=60
# Cada cuántos segundos forzar un "balance" one-shot para que el bot pueda salir de pausas
# aun si Deriv no emite updates de balance.
DERIV_BALANCE_POLL_CADA_SEG=60
# Tipos de contrato permitidos (recomendado: PUT para desactivar CALL si CALL te está drenando).
DERIV_CONTRACT_TYPES_PERMITIDOS=PUT
# Bloqueo horario (hora local) para evitar ventanas malas. Formato: "2-3,22" (rangos inclusivos).
# Vacío = sin bloqueos (opera 24/7). Para bloquear horas: "2-3,22" (bloquea horas 2-3 y 22).
# OPTIMIZADO: Bloquea horas con 100% pérdidas consistentes (basado en análisis 48h)
DERIV_BLOQUEO_HORAS_LOCAL=1,2,6,8,10,11,12,13,14,15,22,23
DERIV_TIMEOUT_PROPUESTA_SEG=15
DERIV_TIMEOUT_CONTRATO_SEG=120

# ===== NORMALIZACIÓN / SEÑAL (RECOMENDADO) =====
# POR QUÉ:
# - SIN NORMALIZACIÓN, w^T x SE DOMINA POR VARIABLES EN ESCALAS DISTINTAS (EMA/RSI/RETORNOS).
NORMALIZAR_VECTOR=True
NORMALIZACION_ALPHA=0.01
NORMALIZACION_MIN_STD=1e-8
NORMALIZACION_CLIP=5.0
SENAL_TOP_N=5

# ===== PESOS (ESTRATEGIA) =====
# EL BOT LEERÁ ESTE JSON SI EXISTE (GENERADO POR EL CALIBRADOR WALK-FORWARD).
PESOS_ARCHIVO=vector_pesos/pesos_calibrados.json
ADAPTATIVO_HABILITADO=False
ADAPTATIVO_ARCHIVO=vector_pesos/umbral_online.json
ADAPTATIVO_UMBRALES=0.05,0.07,0.09,0.11,0.13,0.15
ADAPTATIVO_MIN_TRADES=60
ADAPTATIVO_EDGE_MARGIN=0.02
ADAPTATIVO_MODO_SIN_EVIDENCIA=no_operar
ADAPTATIVO_UMBRAL_WARMUP=0.09

# ===== CALIBRADOR WALK-FORWARD =====
CALIBRADOR_TICKS_COUNT=5000
CALIBRADOR_TRAIN_TICKS=2000
CALIBRADOR_TEST_TICKS=500
CALIBRADOR_LAMBDA_RIDGE=1.0
CALIBRADOR_HORIZON_TICKS=5

# TRADING
# Símbolo Deriv a operar (recomendado setear explícitamente en producción).
DERIV_SYMBOL=R_10
# Estrategia: "vectores" (antigua con w^T x) o "extremos" (nueva basada en máximos/mínimos)
ESTRATEGIA_TIPO=extremos
# Configuración para estrategia de extremos
ESTRATEGIA_EXTREMOS_UMBRAL_RANGO=0.5
# OPTIMIZADO: Cooldown aumentado para reducir frecuencia y mejorar calidad (25 -> 50)
ESTRATEGIA_EXTREMOS_COOLDOWN_TICKS=50
# Configuración avanzada (extremos)
EXTREMOS_VENTANA_TICKS=100
# OPTIMIZADO: Frescura reducida para solo extremos muy recientes (5 -> 3)
EXTREMOS_FRESCURA_TICKS=3
EXTREMOS_VENTANA_REPETICIONES=10
EXTREMOS_MAX_REPETICIONES=2
# Anti "continuación de tendencia": exige reversión mínima (delta) antes de entrar
# OPTIMIZADO: Min reversión aumentada para mayor selectividad (0.05 -> 0.10)
EXTREMOS_MIN_REVERSION_FRAC=0.10
EXTREMOS_MIN_REVERSION_ABS=0.0
# Confirmación 2-ticks: retroceso debe superar el "ruido" típico reciente
EXTREMOS_PROMEDIO_DELTA_TICKS=20
# OPTIMIZADO: Delta factor aumentado para exigir reversiones mayores (1.0 -> 1.5)
EXTREMOS_PROMEDIO_DELTA_FACTOR=1.5
# Configuración para estrategia de vectores (solo si ESTRATEGIA_TIPO=vectores)
UMBRAL_COMPRA=0.75
UMBRAL_VENTA=-0.75
VENTANA_RETORNOS=200
VENTANA_TICKS_RATE=60
MIN_TICKS_CALENTAMIENTO=100
STOP_MIN_PORCENTAJE=0.001
CAPITAL_INICIAL=100.0
MAX_RIESGO_POR_OPERACION=0.01
MAX_DRAWDOWN=0.20
# Histéresis anti “flip-flop” cerca del umbral de drawdown.
# Si MAX_DRAWDOWN=0.05 y MAX_DRAWDOWN_HISTERESIS=0.01:
# - Bloquea si drawdown >= 0.05
# - Desbloquea si drawdown <= 0.04
MAX_DRAWDOWN_HISTERESIS=0.00
# En modo ciclos normalmente se desactiva el drawdown global histórico.
DRAWDOWN_GLOBAL_HABILITADO=True

# ===== CICLOS (MODO REAL) =====
# baseline = balance al iniciar ciclo.
# Si llega a +1.5% => pausa 24h y reinicia ciclo.
# Si llega a -1.0% => pausa 1h y reinicia ciclo.
CICLO_HABILITADO=False
CICLO_TAKE_PROFIT_PCT=0.015
CICLO_STOPLOSS_PCT=0.010
CICLO_PAUSA_TP_SEG=86400
CICLO_PAUSA_SL_SEG=3600
